# ==============================================================================
# ENQU SET NIQU SET - Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in your credentials:
#   cp .env.example .env.local
# ==============================================================================

# 1. Sanity Project ID (Public)
# Found at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id_here

# 2. Sanity Dataset Name
NEXT_PUBLIC_SANITY_DATASET=production

# 3. Sanity API Version
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-11

# 4. Sanity Secret Write Token (Server-side only)
# Create in Sanity Manage -> Settings -> API -> Tokens (Editor/Admin permissions)
SANITY_WRITE_TOKEN=your_sanity_write_token_here
